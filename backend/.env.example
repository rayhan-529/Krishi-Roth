# =====================================================================
# Krishi Roth backend settings
# Copy this file to ".env" in the same folder and fill in the values:
#   Copy-Item .env.example .env        (Windows PowerShell)
# Never commit the real .env file — it is already in .gitignore.
# On Render (or any host) enter the same names in the host's
# "Environment Variables" screen instead of uploading a .env file.
# =====================================================================

# ---- Server ----------------------------------------------------------
NODE_ENV=development
PORT=5000
# Frontend address(es) allowed to call the API, comma-separated, no trailing slash
#   local:      http://localhost:5173
#   production: https://krishi-roth.vercel.app
CLIENT_URL=http://localhost:5173
# true when the API runs behind a hosting proxy (Render, Railway, Nginx)
TRUST_PROXY=false

# ---- MySQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# XAMPP's root user has no password by default; leave empty in that case
DB_PASSWORD=
DB_NAME=krishi_roth
# true for cloud databases that need an encrypted connection (TiDB Cloud, Aiven)
DB_SSL=false

# ---- Login tokens (JWT) ----------------------------------------------
# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Admin account (used by: npm run admin:create) --------------------
# The admin logs in on the normal login page with this email and password.
# Password: at least 8 characters.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- File uploads ----------------------------------------------------
# Maximum size of one uploaded photo/document in megabytes
UPLOAD_MAX_MB=3
# Leave empty to keep photos in backend/uploads (fine on your own computer).
# On Render's free plan the disk is wiped on restart, so use Cloudinary:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME   (Cloudinary dashboard -> API Keys)
CLOUDINARY_URL=

# ---- AI chatbot --------------------------------------------------------
# Provider: gemini | openai | anthropic
AI_PROVIDER=gemini
# Leave AI_API_KEY empty to switch the chatbot off (the page will say so).
# Free Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=
# Optional: override the default model for the chosen provider
#   gemini default:    gemini-3.5-flash
#   openai default:    gpt-4.1-mini
#   anthropic default: claude-haiku-4-5
AI_MODEL=

# ---- Email (password-reset codes, sign-in links) ---------------------
# Leave SMTP_HOST empty while developing: emails are printed in the server
# console instead of being sent.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#   SMTP_USER=you@gmail.com SMTP_PASS=<16-letter Google "App password">
# Free Gmail limit: about 500 emails per day. Check settings with: npm run mail:test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Krishi Roth <no-reply@example.com>

# ---- Google / Apple sign-in ------------------------------------------
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#   OAuth client ID (Web). Add your site to "Authorised JavaScript origins".
#   Use the SAME id in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Apple: developer.apple.com -> Identifiers -> Services ID (needs a paid
#   Apple Developer account). Same value in frontend/.env as VITE_APPLE_CLIENT_ID.
APPLE_CLIENT_ID=

# ---- Wallet / Safe Trade ----------------------------------------------
# The platform's own numbers that users "Send Money" to when adding balance.
# An admin checks each TrxID in this account before approving.
# Leave a number empty to hide that method.
WALLET_BKASH_NUMBER=
WALLET_NAGAD_NUMBER=
WALLET_ROCKET_NUMBER=
# Limits in taka
WALLET_MIN_DEPOSIT=50
WALLET_MAX_DEPOSIT=100000
WALLET_MIN_WITHDRAWAL=100
# Automatic "Add balance" check: an SMS-forwarder app on the phone with the
# bKash/Nagad/Rocket SIM posts each SMS to  <backend URL>/api/wallet-sms?key=THIS_KEY
# Keep it secret. Empty = off (admins approve every request by hand).
WALLET_SMS_SECRET=

# ---- Two-step verification ----------------------------------------------
# SMS codes (optional). Leave SMS_API_KEY empty: codes then go by email.
#   SMS_PROVIDER=alpha      -> Alpha SMS   https://sms.net.bd
#   SMS_PROVIDER=bulksmsbd  -> BulkSMSBD   https://bulksmsbd.net
SMS_PROVIDER=alpha
SMS_API_KEY=
SMS_SENDER_ID=
# true = every admin must use two-step. Turn it on for your own admin account
# first (Profile) and check the code arrives, or admins could be locked out.
ADMIN_REQUIRE_2FA=false
