{
  "name": "krishi-roth-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Krishi Roth backend API (Express + MySQL)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node database/setup.js",
    "db:reset": "node database/setup.js --reset",
