# Address of the Krishi Roth backend API (no trailing slash)
#   local:      http://localhost:5000
#   production: https://krishi-roth-api.onrender.com
VITE_API_URL=http://localhost:5000

# Google sign-in: the same OAuth Web client id as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=
# Apple sign-in: your Apple Services ID and the page Apple returns to
# (must match the Return URL registered with Apple, e.g. https://your-site/login)
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
